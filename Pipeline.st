"Commands connected by operating-system pipes."
class Pipeline [
    | process outputFile |
    initialize [ process := Process new. outputFile := '' ]
    process [ ^ process ]
    environment: overrides [ process environment: overrides. ^ self ]
    input: text [ process input: text. ^ self ]
    start: stages cwd: directory outputFile: path [ outputFile := path. process pipeline: stages cwd: directory outputFile: path. ^ self ]
    outputFile [ ^ outputFile ]
    stdout [ ^ process stdout ]
    stderr [ ^ process stderr ]
    output [ ^ process output ]
    outputLines [ ^ process outputLines ]
    status [ ^ process status ]
    exitCode [ ^ process exitCode ]
    exitCodes [ ^ process pipelineExitCodes ]
    error [ ^ process error ]
    command [ ^ process command ]
    wait [ ^ process wait ]
    signal: name [ ^ process signal: name ]
    stop [ ^ process signal: 'TERM' ]
    inspectorMetadata [ ^ '{"properties":[{"name":"Status","getter":"status","type":"string"},{"name":"Exit code","getter":"exitCode","type":"number"},{"name":"Output file","getter":"outputFile","type":"string"}]}' ]
    inspectorViews [ ^ '{"views":[{"id":"pipeline","title":"Pipeline","body":{"kind":"column","children":[{"kind":"code","label":"Commands","getter":"command"},{"kind":"text","label":"Status","getter":"status"},{"kind":"text","label":"Exit code","getter":"exitCode"},{"kind":"text","label":"Output file","getter":"outputFile"},{"kind":"code","label":"Standard output","getter":"stdout"},{"kind":"code","label":"Standard error","getter":"stderr"},{"kind":"text","label":"Error","getter":"error"},{"kind":"row","children":[{"kind":"action","text":"Stage exit codes","method":"exitCodes"},{"kind":"action","text":"Stop pipeline","method":"stop"}]}]}}]}' ]
]
