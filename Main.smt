(class Main
  (vars dict found scratch result s)

  (method safeDiv:by: (a b)
    (if (send b = 0)
      (return "error: division by zero"))
    (send a / b))

  (method firstOver:in: (threshold collection)
    (set found nil)
    (send collection do: (block (x)
      (if (send found isNil)
        (if (send x > threshold)
          (set found x)))))
    found)

  (method makeList ()
    (set scratch (new Array))
    (send scratch add: 10)
    (send scratch add: 30)
    (send scratch add: 20)
    (send scratch add: 50)
    scratch)

  (method initialize ()
    (print "=== Distributed Smalltalk ===")

    (print "-- (return) from method --")
    (print "10 / 2 =" (safeDiv: 10 by: 2))
    (print "10 / 0 =" (safeDiv: 10 by: 0))

    (print "-- firstOver: --")
    (set result (firstOver: 25 in: (makeList)))
    (print "First element over 25:" result)

    (print "-- Dictionary --")
    (set dict (new Dictionary))
    (send dict at:put: "name" "servicetalk")
    (send dict at:put: "version" "0.1")
    (send dict at:put: "lang" "Smalltalk")
    (print "size:" (send dict size))
    (print "name =" (send dict at: "name"))
    (print "includesKey: version ->" (send dict includesKey: "version"))
    (print "includesKey: foo    ->" (send dict includesKey: "foo"))
    (send dict removeKey: "version")
    (print "After removeKey, size =" (send dict size))
    (send dict keysAndValuesDo: (block (k v)
      (print " " (send (send k , " -> ") , v))))

    (print "-- Math --")
    (print "abs -7 =" (send -7 abs))
    (print "max: 3 9 =" (send 3 max: 9))
    (print "min: 3 9 =" (send 3 min: 9))
    (print "floor 3.7 =" (send 3.7 floor))
    (print "ceiling 3.2 =" (send 3.2 ceiling))
    (print "sqrt 144 =" (send 144 sqrt))

    (print "-- Strings --")
    (set s "Hello, World!")
    (print "size       =" (send s size))
    (print "at: 0      =" (send s at: 0))
    (print "asUppercase=" (send s asUppercase))
    (print "asLowercase=" (send s asLowercase))
    (print "includes:  =" (send s includes: "World"))
    (print "replaceAll:=" (send s replaceAll:with: "World" "Smalltalk"))

    (print "=== Done ===")))
