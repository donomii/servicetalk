(class ObjectWorkspace
  (vars target workspace)
  (method initialize ()
    (set workspace (new __workspace__)))
  (method target: (object)
    (set target object)
    (send workspace setVar:to: "shellContext" target)
    self)
  (method target () target)
  (method evaluate: (source)
    (send workspace evalResult: source))
  (method result ()
    (send workspace getVar: "it"))
  (method bindings () workspace)
)
