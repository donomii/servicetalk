"An interactive operating-system terminal backed by a Process."
class Terminal [
    | process input |
    initialize [ process := Process new. input := '' ]
    process [ ^ process ]
    environment: overrides [ process environment: overrides. ^ self ]
    start: program args: arguments cwd: directory [ process terminalStart: program args: arguments cwd: directory columns: 80 rows: 24. ^ self ]
    write: text [ ^ process terminalWrite: text ]
    sendLine: text [ ^ process terminalWrite: (text , 10 asCharacter asString) ]
    read [ ^ process terminalRead ]
    readFrom: offset [ ^ process terminalReadFrom: offset ]
    output [ ^ process terminalOutput ]
    droppedBytes [ ^ process terminalDropped ]
    resizeColumns: columns rows: rows [ process terminalResizeColumns: columns rows: rows. ^ self ]
    status [ ^ process status ]
    exitCode [ ^ process exitCode ]
    error [ ^ process error ]
    command [ ^ process command ]
    pid [ ^ process pid ]
    wait [ ^ process wait ]
    signal: name [ ^ process signal: name ]
    stop [ ^ process signal: 'KILL' ]
    interrupt [ ^ process terminalWrite: 3 asCharacter asString ]
    input [ ^ input ]
    input: text [ input := text. ^ self ]
    sendInput [ ^ self sendLine: input ]
    inspectorMetadata [ ^ '{"properties":[{"name":"Status","getter":"status","type":"string"},{"name":"Exit code","getter":"exitCode","type":"number"},{"name":"Unread bytes dropped","getter":"droppedBytes","type":"number"}],"methods":{"write:":{"arguments":[{"name":"text","type":"string"}],"returns":"number"},"sendLine:":{"arguments":[{"name":"text","type":"string"}],"returns":"number"},"resizeColumns:rows:":{"arguments":[{"name":"columns","type":"number"},{"name":"rows","type":"number"}]}}}' ]
    inspectorViews [ ^ '{"views":[{"id":"terminal","title":"Terminal","body":{"kind":"column","children":[{"kind":"code","label":"Command","getter":"command"},{"kind":"text","label":"Status","getter":"status"},{"kind":"code","label":"Terminal output","getter":"output"},{"kind":"input","label":"Input","getter":"input","setter":"input:","type":"string"},{"kind":"row","children":[{"kind":"action","text":"Send line","method":"sendInput"},{"kind":"action","text":"Interrupt","method":"interrupt"},{"kind":"action","text":"Stop","method":"stop"}]},{"kind":"text","label":"Error","getter":"error"}]}}]}' ]
]
