"Live GUI state and message bindings shared by visual controls."
class Control [
    | kind label text receiver getter setter selector arguments children owner wiring refresh valueType options |
    initialize [ kind := 'value'. label := ''. text := ''. getter := ''. setter := ''. selector := ''. receiver := nil. owner := nil. wiring := nil. arguments := Array new. children := Array new. refresh := false. valueType := ''. options := '{}' ]
    kind [ ^ kind ]
    label [ ^ label ]
    label: value [ label := value. ^ self ]
    text [ ^ text ]
    text: value [ text := value. ^ self ]
    receiver [ ^ receiver ]
    receiver: object [ receiver := object. ^ self ]
    getter [ ^ getter ]
    getter: method [ getter := method. ^ self ]
    setter [ ^ setter ]
    setter: method [ setter := method. ^ self ]
    method [ ^ selector ]
    method: name [ selector := name. ^ self ]
    arguments [ ^ arguments ]
    arguments: values [ arguments := values. ^ self ]
    children [ ^ children ]
    children: controls [ ^ self __controlChildren: controls ]
    add: control [ ^ self __controlAdd: control ]
    remove: control [ ^ self __controlRemove: control ]
    owner [ ^ owner ]
    view [ owner isNil ifTrue: [ ^ nil ] ifFalse: [ ^ owner view ] ]
    wiring [ ^ wiring ]
    wiring: graph [ wiring := graph. ^ self ]
    refresh [ ^ refresh ]
    refresh: value [ refresh := value. ^ self ]
    valueType [ ^ valueType ]
    valueType: name [ valueType := name. ^ self ]
    options [ ^ options ]
    options: json [ options := json. ^ self ]
    effectiveReceiver [ receiver isNil ifTrue: [ owner isNil ifTrue: [ ^ nil ] ifFalse: [ ^ owner effectiveReceiver ] ] ifFalse: [ ^ receiver ] ]
    read [ getter = '' ifTrue: [ ^ text ] ifFalse: [ ^ self effectiveReceiver perform: getter withArguments: arguments ] ]
    write: value [ setter = '' ifTrue: [ 'This control has no setter' signal ] ifFalse: [ ^ self effectiveReceiver perform: setter with: value ] ]
    invoke [ wiring isNil ifTrue: [ selector = '' ifTrue: [ 'This control has no action method' signal ] ifFalse: [ ^ self effectiveReceiver perform: selector withArguments: arguments ] ] ifFalse: [ ^ wiring run ] ]
    state [ ^ self __controlState ]
    definition [ ^ self __describeControl ]
    inspectorMetadata [ ^ '{"properties":[{"name":"label","getter":"label","setter":"label:","type":"string"},{"name":"text","getter":"text","setter":"text:","type":"string"},{"name":"receiver","getter":"receiver","setter":"receiver:","type":"objid"},{"name":"getter","getter":"getter","setter":"getter:","type":"string"},{"name":"setter","getter":"setter","setter":"setter:","type":"string"},{"name":"method","getter":"method","setter":"method:","type":"string"},{"name":"arguments","getter":"arguments","setter":"arguments:","type":"objid"},{"name":"children","getter":"children","type":"objid"},{"name":"owner","getter":"owner","type":"objid"},{"name":"wiring","getter":"wiring","setter":"wiring:","type":"objid"},{"name":"refresh","getter":"refresh","setter":"refresh:","type":"bool"},{"name":"value type","getter":"valueType","setter":"valueType:","type":"string"},{"name":"options","getter":"options","setter":"options:","type":"string"}]}' ]
]
